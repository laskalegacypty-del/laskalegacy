# ─── Supabase Configuration ───
# Find these in your Supabase Dashboard → Settings → API
#
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=https://hasoqmxmvylgwinppthk.supabase.co

# Anon/Public key (starts with eyJ...):
# Go to Dashboard → Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Stall Price List QR Labels (optional) ───
# Overrides the domain baked into printed QR labels (defaults to
# https://laskalegacy.co.za in code). Only set this if you move to a
# different domain.
# NEXT_PUBLIC_SITE_URL=https://laskalegacy.co.za

# ─── Website Intake (/websites) ───
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The one email allowed into /admin/submissions (create this user in Supabase → Authentication → Users).
OWNER_EMAIL=you@example.com
# Emails via Resend (https://resend.com). Without a key, emails are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM=Laska Legacy Websites <websites@laskalegacy.co.za>
# Shown to clients in the confirmation email (defaults: laskalegacypty@gmail.com / 072 585 8288).
# OWNER_CONTACT_EMAIL=
# OWNER_CONTACT_WHATSAPP=
# WEBSITE_TURNAROUND=within 5 working days of your payment
# PayFast. Sandbox is the default and uses PayFast's public test merchant when these are blank.
PAYFAST_SANDBOX=true
# TODO(live): set PAYFAST_SANDBOX=false and fill in your REAL merchant details before taking real payments.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Set to false to skip the built-in PayFast screen (you send your own payment link)
# WEBSITE_PAYFAST_ENABLED=false

# Must match the password used to sign in to the shop Admin page
WEBSITE_ADMIN_PASSWORD=
